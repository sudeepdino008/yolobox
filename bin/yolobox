#!/usr/bin/env bash
# yolobox — sandboxed git worktrees for claude code
#
# Usage:
#   yolobox setup                 — one-time configuration
#   yolobox new <branch_name>     — create a sandboxed worktree and immediately attach
#   yolobox create <branch_name>  — create a sandboxed worktree
#   yolobox attach [--shell]      — pick a worktree with fzf and launch claude (or shell)
#   yolobox shell                 — pick a worktree with fzf and launch shell in sandbox
#   yolobox list                  — show all worktrees
#   yolobox cd                    — print worktree path (use: cd $(yolobox cd))
#   yolobox delete <branch_name>  — remove a worktree (keeps session state)

set -euo pipefail

# Resolve lib directory relative to this script
YOLOBOX_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
YOLOBOX_LIB_DIR="${YOLOBOX_BIN_DIR}/../lib"

# Source libraries
# shellcheck source=../lib/common.sh
source "${YOLOBOX_LIB_DIR}/common.sh"
# shellcheck source=../lib/config.sh
source "${YOLOBOX_LIB_DIR}/config.sh"
# shellcheck source=../lib/sandbox.sh
source "${YOLOBOX_LIB_DIR}/sandbox.sh"
# shellcheck source=../lib/worktree.sh
source "${YOLOBOX_LIB_DIR}/worktree.sh"

usage() {
    echo "Usage: yolobox <command> [args]"
    echo ""
    echo "Commands:"
    echo "  setup                 One-time configuration (deps, worktree location)"
    echo "  new <branch_name>     Create a sandboxed worktree and attach immediately"
    echo "  create <branch_name>  Create a sandboxed worktree"
    echo "    --attach            Launch claude in the new worktree after creating it"
    echo "  attach [--shell]      Pick a worktree with fzf and launch claude (or shell) in sandbox"
    echo "  shell                 Pick a worktree with fzf and launch shell in sandbox"
    echo "  list                  Show all worktrees for the current project"
    echo "  cd                    Print worktree path (use: cd \$(yolobox cd))"
    echo "  delete <branch_name>  Remove a worktree (session state is preserved)"
    echo ""
    echo "Run 'yolobox setup' first to configure."
}

cmd_setup() {
    config_setup
}

cmd_create() {
    local do_attach=0
    local branch=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --attach) do_attach=1; shift ;;
            -*) die "Unknown flag: $1" ;;
            *) branch="$1"; shift ;;
        esac
    done
    if [[ -z "$branch" ]]; then
        die "Usage: yolobox create <branch_name> [--attach]"
    fi
    config_load
    worktree_create "$branch"
    if [[ $do_attach -eq 1 ]]; then
        _attach_to_branch "$branch" ""
    fi
}

cmd_new() {
    if [[ $# -lt 1 ]]; then
        die "Usage: yolobox new <branch_name>"
    fi
    config_load
    worktree_create "$1"
    _attach_to_branch "$1" ""
}

_attach_to_branch() {
    local branch="$1"
    local sandbox_cmd="${2:-}"

    local wt_path
    wt_path=$(worktree_path "$branch")
    local hm_path
    hm_path=$(home_path "$branch")

    if [[ ! -d "$hm_path" ]]; then
        warn "Synthetic home missing, recreating..."
        _setup_synthetic_home "$branch" "$hm_path"
    fi

    local project
    project=$(detect_project_name)
    local extra_reads
    extra_reads=$(config_get_allow_reads "$project")
    local extra_writes
    extra_writes=$(config_get_allow_writes "$project")
    local extra_envs
    extra_envs=$(config_get_allow_envs "$project")

    sandbox_exec "$wt_path" "$hm_path" "$extra_reads" "$extra_writes" "$sandbox_cmd" "$extra_envs"
}

_attach_or_shell() {
    local sandbox_cmd="${1:-}"
    config_load

    local wt_base
    wt_base=$(worktrees_base)

    if [[ ! -d "$wt_base" ]]; then
        die "No worktrees found. Run 'yolobox create <branch_name>' first."
    fi

    # Gather branch names (handles slashes in branch names)
    local branches=()
    while IFS= read -r branch; do
        [[ -z "$branch" ]] && continue
        branches+=("$branch")
    done < <(_list_worktree_branches)

    if [[ ${#branches[@]} -eq 0 ]]; then
        die "No worktrees found. Run 'yolobox create <branch_name>' first."
    fi

    # If only one worktree, select it directly
    local selected
    if [[ ${#branches[@]} -eq 1 ]]; then
        selected="${branches[0]}"
        info "Only one worktree found, selecting '${selected}'"
    else
        # Use fzf to pick
        selected=$(printf '%s\n' "${branches[@]}" | fzf --prompt="Select worktree: " --height=10 --reverse) || die "No worktree selected."
    fi

    _attach_to_branch "$selected" "$sandbox_cmd"
}

cmd_attach() {
    local sandbox_cmd=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --shell) sandbox_cmd="${SHELL:-/bin/bash}"; shift ;;
            *) die "Unknown flag: $1" ;;
        esac
    done
    _attach_or_shell "$sandbox_cmd"
}

cmd_shell() {
    _attach_or_shell "${SHELL:-/bin/bash}"
}

cmd_cd() {
    local paths=()
    while IFS= read -r line; do
        paths+=("${line%% *}")
    done < <(git worktree list)

    if [[ ${#paths[@]} -eq 0 ]]; then
        die "No worktrees found."
    fi

    local selected
    if [[ ${#paths[@]} -eq 1 ]]; then
        selected="${paths[0]}"
    else
        selected=$(printf '%s\n' "${paths[@]}" | fzf --prompt="Select worktree: " --height=10 --reverse) || die "No worktree selected."
    fi

    echo "$selected"
}

cmd_list() {
    config_load
    worktree_list
}

cmd_delete() {
    if [[ $# -lt 1 ]]; then
        die "Usage: yolobox delete <branch_name>"
    fi
    config_load
    worktree_delete "$1"
}

# Main dispatcher
if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

command="$1"
shift

case "$command" in
    setup)  cmd_setup "$@" ;;
    new)    cmd_new "$@" ;;
    create) cmd_create "$@" ;;
    attach) cmd_attach "$@" ;;
    shell)  cmd_shell "$@" ;;
    cd)     cmd_cd "$@" ;;
    list)   cmd_list "$@" ;;
    delete) cmd_delete "$@" ;;
    help|-h|--help)
        usage
        exit 0
        ;;
    *)
        die "Unknown command: $command. Run 'yolobox help' for usage."
        ;;
esac
